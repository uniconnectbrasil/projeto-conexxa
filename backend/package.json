{
  "name": "connexa-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Back-end do Connexa: monolito modular em NestJS, com fatias verticais.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma migrate deploy && nest start --watch",
    "start": "prisma migrate deploy && node dist/main.js",
    "build": "nest build",
    "lint": "eslint .",
    "tipos": "tsc --noEmit",
    "test": "vitest run",
    "test:observar": "vitest",
    "banco:migrar": "prisma migrate deploy",
    "banco:nova-migracao": "prisma migrate dev --create-only --name",
    "verificar": "prisma generate && npm run lint && npm run tipos && npm run test && npm run build"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/testing": "12.1.3",
    "@swc/core": "1.16.18",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.13.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
